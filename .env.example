# Copiar a .env y completar con valores reales antes de `docker compose up`.
# .env ya está en .gitignore — nunca commitear el archivo real con secretos.
#
# Generar valores fuertes con, por ejemplo:
#   openssl rand -hex 32

# --- Imagen (solo relevante para docker-compose.prod.yml con registry) ---
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=tu-org

# --- PostgreSQL / TimescaleDB (usuario "sensors") ---
# Usado por: db, db_replica, pgbouncer, web (BEEMETRY_DATABASE_URL,
# BEEMETRY_TELEMETRY_DATABASE_URL). Rotar invalida conexiones activas —
# reiniciar db, db_replica, pgbouncer, web tras cambiar.
BEEMETRY_DB_PASSWORD=

# --- MinIO (archivado Parquet, ADR-009) ---
# Usado por: minio, minio_init, web (BEEMETRY_MINIO_ACCESS_KEY/SECRET_KEY).
BEEMETRY_MINIO_ROOT_USER=
BEEMETRY_MINIO_ROOT_PASSWORD=

# --- formula_db / formula_engine (motor de fórmulas embebido) ---
BEEMETRY_FORMULA_DB_PASSWORD=
BEEMETRY_FORMULA_AUTH_TOKEN=

# --- JWT (sesiones de auth, ADR-029) ---
# CRÍTICO: no dejar vacío ni reusar el valor por defecto antiguo del repo.
# Rotar invalida TODAS las sesiones activas de inmediato.
BEEMETRY_JWT_SECRET=

# TTL del access token JWT en minutos (clamp [1,120] en app_config.cpp).
# Vuelto de 60 a 15 en la migración a Bearer-en-memoria (ver ADR de esa
# migración): con el token vivo en memoria de JS (no solo en cookie
# HttpOnly), la ventana de exposición ante un XSS pesa más que la frecuencia
# de renovación -- que sigue siendo transparente (refresh proactivo +
# reintento automático en 401, authApi.ts).
BEEMETRY_JWT_ACCESS_TTL_MINUTES=15

# TTL de sesión server-side en minutos (mecanismo separado del par
# access/refresh JWT de arriba, ver gSessionTtlMinutes en app_config.cpp).
# Antes solo vivía como default hardcodeado (480 min); documentado acá desde
# 2026-08-19.
BEEMETRY_AUTH_SESSION_TTL_MINUTES=480

# Origen(es) web permitidos por CORS. Producción: URL(es) HTTPS exacta(s),
# sin wildcard. ADR-081: admite una lista separada por comas para soportar
# más de un frontend contra el mismo backend (p.ej. una segunda app en otro
# subdominio), reflejando por request cuál matchea. Recomendado: desplegar
# cada frontend como subdominio del mismo dominio registrable del backend,
# para que las cookies de sesión (SameSite=Strict) sigan funcionando sin
# cambios (ver docs/decisions/081-cors-multiorigen-frontend-externo.md).
BEEMETRY_CORS_ALLOWED_ORIGIN=http://localhost:5173
# Ejemplo con dos frontends:
# BEEMETRY_CORS_ALLOWED_ORIGIN=https://app1.midominio.com,https://app2.midominio.com

# --- Contraseñas Argon2id (ADR-077) ---
BEEMETRY_ARGON2_TIME_COST=3
BEEMETRY_ARGON2_MEMORY_KIB=65536
BEEMETRY_ARGON2_PARALLELISM=1
# Compatibilidad temporal con hashes históricos. Mantener el valor usado por
# la instalación previa hasta que el inventario de hashes legados llegue a 0.
BEEMETRY_AUTH_LEGACY_PASSWORD_SALT=mining_local_salt_change_me

# Clave estable para cifrado AES-256-GCM de exportaciones .mreport.
# OBLIGATORIA: sin ella, exportar/importar responde "export_key_not_configured"
# (antes caía a una clave publicada en el repo, que no protegía nada).
# Cambiarla impide abrir archivos ya exportados.
BEEMETRY_REPORT_EXPORT_KEY=

# Contraseña de PROPIETARIO de los PDF exportados (permisos: imprimir sí,
# copiar/editar no). OBLIGATORIA: sin ella el servicio pdf_export no arranca.
PDF_OWNER_PASSWORD_SECRET=

# --- Escotillas SOLO para desarrollo local (auditoría 2026-08-02) ---
# Autorizan explícitamente el uso de secretos por defecto conocidos. Dejar
# VACÍAS en cualquier entorno real: activarlas desprotege exportaciones .mreport
# y PDF, y desactiva la autenticación por API key.
BEEMETRY_ALLOW_DEV_SECRETS=
PDF_ALLOW_DEV_SECRETS=
BEEMETRY_API_AUTH_OPTIONAL=

# Contraseña de PROPIETARIO (no de usuario) de los PDF exportados con marca
# de agua (ADR-080) — fija permisos (imprimir sí, copiar/editar no) y nunca
# se muestra al usuario final. Producción la exige (docker-compose.prod.yml).
PDF_OWNER_PASSWORD_SECRET=

# --- Réplica de lectura KPI (dashboard_ro) ---
# NOTA: el rol dashboard_ro todavía no existe en db_scripts/ — ver RUNBOOK.md
# sección Seguridad. Definir igual para cuando se provisione.
BEEMETRY_DASHBOARD_RO_PASSWORD=

# --- Opcionales (ver docker-compose.yml para el resto de flags no-secretos) ---
BEEMETRY_KPI_EXTERNAL_DATABASE_URL=
BEEMETRY_KPI_EXTERNAL_QUERY=
BEEMETRY_OLLAMA_MODEL=tinyllama

# --- Biometría facial local: DeepFace (Facenet512) + Silent-Face-Anti-Spoofing ---
# Proveedor local por defecto (reemplaza a SeetaFace6, ver ADR de supersesión
# en docs/decisions/). Libre y on-premise; no implica certificación
# RENIEC/ISO/NIST del producto.
BEEMETRY_BIOMETRIC_PROVIDER=deepface_silentface
BEEMETRY_DEEPFACE_SILENTFACE_REQUIRED=true
BEEMETRY_DEEPFACE_SILENTFACE_TIMEOUT_MS=25000
# Distancia coseno Facenet512 < 0.30 (doc técnico de referencia) == similitud
# >= 0.70 en la convención de este código (más alto = más parecido).
BEEMETRY_FACE_DEEPFACE_COSINE_THRESHOLD=0.70
BEEMETRY_SILENTFACE_LIVENESS_THRESHOLD=0.60
# Cascada a Dermalog SOLO ante fallo de infraestructura (ai_engine caído),
# nunca ante un rechazo de seguridad (spoof) -- ver face_analysis.cpp.
BEEMETRY_DEEPFACE_SILENTFACE_DERMALOG_FALLBACK=false
DEEPFACE_WEIGHTS_HOST_DIR=./biometric-models/deepface
DEEPFACE_SILENTFACE_DETECTION_HOST_DIR=./biometric-models/deepface_silentface/detection
DEEPFACE_SILENTFACE_ANTISPOOF_HOST_DIR=./biometric-models/deepface_silentface/anti_spoof
# GPU opcional -- id de dispositivo CUDA para Silent-Face (torch). Sin GPU
# visible en el host, cae a CPU automáticamente.
SILENTFACE_DEVICE_ID=0

# --- Piloto QA del avatar por difusión (ADR-141/143, actualización
# 2026-09-11 de ADR-167) ---
# Mientras no se autorice producción completa, solo estas cuentas ven el
# estilo generativo real (SD1.5) en su avatar de bienvenida al registrarse;
# el resto cae a clásico aunque AVATAR_STYLE_ENGINE (más abajo) esté en
# "diffusion". Usernames separados por coma, comparación case-insensitive.
# Vacío = nadie (default seguro), no "todos".
AVATAR_DIFFUSION_QA_USERNAMES=

# --- Avatar estilizado local por difusión (ADR-141) ---
# classic: estilizador OpenCV; diffusion: SD1.5 + ControlNet-Canny mediante
# el sidecar avatar_engine. NOTA (corregido 2026-09-04): avatar_engine ya NO
# tiene perfil Compose desde el 2026-09-03 -- arranca siempre con
# `docker compose up` normal y reserva ~4.7GB de VRAM de forma permanente.
# El default de este archivo se deja en "classic" a propósito (conservador
# para quien copie .env.example sin leer más), aunque docker-compose.yml ya
# usa diffusion como fallback propio si esta variable no está definida.
AVATAR_STYLE_ENGINE=classic
AVATAR_ENGINE_REQUIRE_GPU=1
AVATAR_ENGINE_TIMEOUT_SECONDS=45
AVATAR_ENGINE_MAX_QUEUE=3

# --- Avatar ANIMADO por reenactment/lip-sync (ADR-150, evaluación) ---
# Servicio aparte (avatar_animation_engine, puerto 5003), GATEADO por perfil
# Compose ("avatar-animation") -- NO cabe corriendo junto a avatar_engine de
# forma sostenida en los 8151 MiB de VRAM disponibles (ver ADR-150). Activar
# solo para evaluación puntual:
#   docker compose --profile avatar-animation up -d avatar_animation_engine
# sadtalker: único backend implementado (sin bloqueante de licencia).
# liveportrait/latentsync: documentados en ADR-150 Fase B/C, no implementados
# todavía (requieren parche InsightFace->MediaPipe antes de poder usarse).
AVATAR_ANIMATION_ENGINE=sadtalker
AVATAR_ANIMATION_REQUIRE_GPU=1
# 300s: medido real (2026-09-07) con foto de usuario + ~10s de audio -> 232s
# con --size 512. Fotos de cámara/celular sin redimensionar agotaban 180s.
AVATAR_ANIMATION_TIMEOUT_SECONDS=300
AVATAR_ANIMATION_MAX_QUEUE=3
# Redimensiona la foto fuente antes de invocar SadTalker (hallazgo real
# 2026-09-07, ADR-150): sin esto, fotos de cámara a resolución nativa
# agotaban el timeout con --preprocess full.
AVATAR_ANIMATION_SADTALKER_MAX_SOURCE_SIDE=1024

# --- Biometría facial local SeetaFace6 (heredado, ADR-104) ---
# Ya no es el proveedor por defecto; se mantiene para rollback/comparación.
# Para usarlo: BEEMETRY_BIOMETRIC_PROVIDER=seetaface6 arriba.
BEEMETRY_SEETAFACE6_REQUIRED=true
BEEMETRY_SEETAFACE6_TIMEOUT_MS=20000
# Punto inicial conservador; requiere calibración local documentada antes de producción.
BEEMETRY_FACE_SEETAFACE6_COSINE_THRESHOLD=0.80
SEETAFACE6_MODEL_HOST_DIR=./biometric-models/seetaface6/sf3.0_models
SEETAFACE6_TIMEOUT_SECONDS=20
SEETAFACE6_BUILD_JOBS=2
SEETAFACE6_COMMIT=a32e2faa0694c0f841ace4df9ead0407b78363c6

# Mapas: solo hosts HTTPS públicos listados pueden atravesar el proxy WMS.
BEEMETRY_WMS_ALLOWED_HOSTS=geocatmin.ingemmet.gob.pe,geoportal.minem.gob.pe,www.idep.gob.pe,idesep.senamhi.gob.pe,basemap.nationalmap.gov
BEEMETRY_WMS_PROXY_TIMEOUT_MS=8000
BEEMETRY_WMS_PROXY_MAX_BYTES=8388608

# Agregador de mapa: intervalo de polling para el push diferencial de
# marcadores por WS (map_markers_diff). La query va indexada
# (idx_map_markers_tenant_geo / idx_sensors_tenant_geo); subir este valor
# solo si hay muchos tenants con listeners activos simultáneos.
BEEMETRY_MAP_AGGREGATOR_POLL_MS=1500

# ADR-034: broker MQTT (Mosquitto) para ingesta de telemetria
BEEMETRY_MQTT_USERNAME=beemetry
BEEMETRY_MQTT_PASSWORD=cambiar-por-secreto-fuerte

# ADR-103: integración RP (TimeTelemetry/Odoo). BEEMETRY_RP_SYNC_ENABLED y el
# resto de tunables tienen default seguro en docker-compose.yml, no hace
# falta definirlos acá salvo que se quieran sobreescribir. La credencial de
# TimeTelemetry NUNCA va en un .env -- vive solo en etl_sync_peer.auth_config
# (fila en Postgres, cargada por el usuario/ops). Esta key SÍ es un secreto
# de este backend (no de TimeTelemetry): protege POST /api/rp/webhook/odoo,
# fail-closed (503) si se deja vacío.
BEEMETRY_RP_WEBHOOK_KEY=

# --- WhatsApp Business Cloud API (Meta) -- bot conversacional (ADR-112) ---
# Credenciales de la app de Meta / número verificado. Vacías = el escalamiento
# saliente y el webhook de entrada quedan deshabilitados (no rompe el resto
# del backend, solo esas rutas responden 503/404).
BEEMETRY_WHATSAPP_PHONE_NUMBER_ID=
BEEMETRY_WHATSAPP_ACCESS_TOKEN=
BEEMETRY_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Números E.164 sin '+' del equipo humano que recibe cada categoría del menú.
BEEMETRY_WHATSAPP_SUPPORT_TO_E164=
BEEMETRY_WHATSAPP_COMERCIAL_TO_E164=
# Recursos Humanos (ADR-115) -- quinta categoría del menú del bot.
BEEMETRY_WHATSAPP_RRHH_TO_E164=
# Postulaciones de CV por WhatsApp (ADR-122) -- correo que recibe el CV
# adjunto + resumen extraído + score de cada postulación. Valor de prueba
# usado en desarrollo: luder.eder.armas.jaimes.leaj@gmail.com
BEEMETRY_HR_CV_EMAIL_TO=
# Tope de tamaño del CV descargado de WhatsApp, en bytes (default 10485760 =
# 10MB si se deja vacío). Ver AppConfig::gWhatsappCvMaxBytes.
BEEMETRY_WHATSAPP_CV_MAX_BYTES=
# Modelo de Ollama para extracción de campos + score del CV (ADR-122) --
# default qwen2.5:7b (mismo modelo de "máxima capacidad" ya usado para APA7).
BEEMETRY_OLLAMA_CV_MODEL=
# Números E.164 sin '+' autorizados para la opción oculta "Administración"
# del bot (ADR-114) -- lista separada por comas, sin espacios. Sin login en
# WhatsApp: esta lista ES el mecanismo de autorización.
BEEMETRY_WHATSAPP_ADMIN_TO_E164=
# Token arbitrario que se configura también en el panel de Meta (handshake
# GET de verificación del webhook) -- generar con `openssl rand -hex 24`.
BEEMETRY_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# "App secret" de la app de Meta -- firma cada POST del webhook
# (X-Hub-Signature-256). Nunca inventar un valor: es el que Meta muestra en
# el panel de la app, no un secreto local. Es UNO solo para toda la App,
# aunque tenga varias líneas (ver ADR-113 abajo): Meta firma por App, no por
# número.
BEEMETRY_WHATSAPP_APP_SECRET=

# --- Backup offsite (rclone, ADR-131) -------------------------------------
# scripts/backup_db.sh ya hace pg_dump + rotación local (14 días) sin
# necesidad de configurar nada. Estas 2 variables son SOLO para el sync
# offsite opcional (BACKUP_REMOTE=1) -- sin ellas, el backup sigue
# funcionando, pero un ransomware que cifre el disco del VPS también cifra
# los backups locales (ver cabecera de backup_db.sh). Sin proveedor
# offsite definido todavía -- placeholder documentado hasta que se elija uno
# (S3/Azure Blob/otro datacenter) y se corra `rclone config` localmente.
# BACKUP_REMOTE=1
# RCLONE_REMOTE=mi-remote:beemetry-backups
# Cron sugerido (después de la ventana de compresión nocturna):
#   0 3 * * * cd /ruta/al/repo && BACKUP_REMOTE=1 ./scripts/backup_db.sh >> /var/log/beemetry-backup.log 2>&1
# NOTA: db_replica (streaming replication) NO sustituye a este backup --
# propaga DELETEs/corrupción lógica del primario en tiempo casi real.

# --- WhatsApp multi-línea (ADR-113) -- áreas con su propio número --------
# La línea de arriba (PHONE_NUMBER_ID/ACCESS_TOKEN) sigue siendo la línea
# "default" (compatibilidad, ADR-112). Para conectar números adicionales de
# la MISMA WABA/App de Meta (p. ej. un número dedicado a soporte y otro a
# comercial, cada uno con su propio bot), listar sus ids acá y definir un
# bloque de 3 variables por cada uno. Vacía = solo existe la línea default,
# comportamiento idéntico al de antes de ADR-113.
BEEMETRY_WHATSAPP_EXTRA_LINES=
# Ejemplo para dos líneas adicionales "soporte" y "comercial" (dejar vacío
# si no se usan, o copiar el patrón con otros ids):
#   BEEMETRY_WHATSAPP_EXTRA_LINES=soporte,comercial
#   BEEMETRY_WHATSAPP_LINE_SOPORTE_PHONE_NUMBER_ID=
#   BEEMETRY_WHATSAPP_LINE_SOPORTE_ACCESS_TOKEN=
#   BEEMETRY_WHATSAPP_LINE_SOPORTE_LABEL=Soporte técnico
#   BEEMETRY_WHATSAPP_LINE_COMERCIAL_PHONE_NUMBER_ID=
#   BEEMETRY_WHATSAPP_LINE_COMERCIAL_ACCESS_TOKEN=
#   BEEMETRY_WHATSAPP_LINE_COMERCIAL_LABEL=Área comercial

# --- API de notificaciones multi-canal (notify/, 2026-08-29) --------------
# Canal "email" y "in_app" (notificaciones internas) funcionan sin
# configuración adicional -- reusan el SMTP (BEEMETRY_SMTP_HOST/PORT/USER/
# PASS/TLS, mismas variables que el notificador de alarmas mineras) y la
# tabla `notifications`, respectivamente.
#
# Canal "whatsapp": Meta exige que TODO mensaje iniciado por el negocio (no
# una respuesta dentro de la ventana de 24h de un mensaje entrante) use una
# plantilla PRE-APROBADA en la cuenta de WhatsApp Business -- registrar esa
# plantilla en la consola de Meta y poner su nombre acá. Sin esto, el canal
# whatsapp se omite (no falla en silencio: queda registrado en
# notification_dispatch_log con detail="whatsapp_sin_plantilla_configurada").
BEEMETRY_WHATSAPP_NOTIFY_TEMPLATE=

# Canal "sms": proveedor Twilio (elegido tras comparar alternativas gratis/
# piloto -- ver el comentario completo en backend/src/notify/sms_client.hpp).
# Cuenta trial de Twilio: gratis, ~US$15.50 de crédito, pero SOLO envía a
# números verificados en la consola de Twilio y antepone "Sent from your
# Twilio trial account -" al texto. Sin estas tres variables, el canal sms
# se omite (detail="sms_no_configurado").
BEEMETRY_TWILIO_ACCOUNT_SID=
BEEMETRY_TWILIO_AUTH_TOKEN=
BEEMETRY_TWILIO_FROM_NUMBER=

# Fotocheck (credencial con foto real + QR cifrado, ver
# backend/src/auth/fotocheck_routes.cpp). BEEMETRY_PUBLIC_ORIGIN debe ser el
# dominio/IP público real donde la plataforma es alcanzable desde un
# celular (no la red interna de Docker) -- se usa para armar el link que se
# manda por email/WhatsApp al terminar el registro. Sin esto, el envío del
# link se omite (no se manda una URL rota). BEEMETRY_FOTOCHECK_QR_KEY es una
# clave AES-256-GCM de 32 bytes en base64 (generar una sola vez con
# `openssl rand -base64 32`); sin ella, el endpoint del fotocheck responde
# 503 en vez de cifrar con una clave débil/por defecto.
BEEMETRY_PUBLIC_ORIGIN=
BEEMETRY_FOTOCHECK_QR_KEY=

# --- Validación externa de RUC (ADR-087, activado 2026-09-11) -------------
# SUNAT no publica API REST oficial gratuita; consulta vía proveedor de
# terceros (ver backend/src/auth/tax_registry_client.cpp), opcional, nunca
# bloqueante (GET /api/auth/validate-company cae al checksum local si esto
# falla o está apagado). Proveedor contratado: Chequea (https://chequea.pe),
# GET https://api.chequea.pe/api/v1/ruc/{ruc} con Bearer token -- mismo
# contrato que el cliente ya soportaba, sin cambios de esquema de respuesta.
# BEEMETRY_TAX_REGISTRY_TOKEN es secreto real: nunca lo pongas acá, solo en
# tu .env local (gitignored) o en el secret manager del entorno.
BEEMETRY_TAX_REGISTRY_ENABLED=false
BEEMETRY_TAX_REGISTRY_HOST=api.chequea.pe
BEEMETRY_TAX_REGISTRY_PATH_TEMPLATE=/api/v1/ruc/{ruc}
BEEMETRY_TAX_REGISTRY_TOKEN=
BEEMETRY_TAX_REGISTRY_TIMEOUT_MS=2500
