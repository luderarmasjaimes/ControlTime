# syntax=docker/dockerfile:1.7
FROM python:3.10-bookworm AS seetaface_builder

ARG SEETAFACE6_COMMIT=a32e2faa0694c0f841ace4df9ead0407b78363c6
ARG SEETAFACE6_BUILD_JOBS=2
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

# El commit queda fijado para que el build no cambie silenciosamente. Los
# modelos no se hornean en la imagen: se montan read-only y se verifican por
# SHA-256 según docs/integration/SEETAFACE6_LOCAL_DOCKER.md.
RUN git clone --recursive https://github.com/SeetaFace6Open/index.git /src/seetaface6 \
    && cd /src/seetaface6 \
    && git checkout "$SEETAFACE6_COMMIT" \
    && git submodule update --init --recursive \
    && sed -i '9i#include <functional>' /src/seetaface6/OpenRoleZoo/include/orz/mem/pot.h \
    && sed -i 's/-DTS_DYNAMIC_INSTRUCTION=ON/-DTS_DYNAMIC_INSTRUCTION=OFF/' \
       /src/seetaface6/TenniS/craft/build.linux.x64.sh \
    && find . -path '*/craft/build.linux.x64.sh' -type f \
       -exec sed -i -e 's/mkdir "$BUILD_DIR"/mkdir -p "$BUILD_DIR"/' \
                    -e "s/make -j16/make -j${SEETAFACE6_BUILD_JOBS}/" {} +

RUN cd /src/seetaface6/OpenRoleZoo/craft && bash build.linux.x64.sh \
    && cd /src/seetaface6/SeetaAuthorize/craft && bash build.linux.x64.sh \
    && cd /src/seetaface6/TenniS/craft && bash build.linux.x64.sh \
    && cd /src/seetaface6/FaceBoxes/craft && bash build.linux.x64.sh \
    && cd /src/seetaface6/Landmarker/craft && bash build.linux.x64.sh \
    && cd /src/seetaface6/FaceAntiSpoofingX6/craft && bash build.linux.x64.sh \
    && cd /src/seetaface6/FaceRecognizer6/craft && bash build.linux.x64.sh

COPY seetaface6_cli /src/seetaface6_cli
RUN cmake -S /src/seetaface6_cli -B /src/seetaface6_cli/build \
      -DSEETAFACE_ROOT=/src/seetaface6/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/seetaface6 \
    && cmake --build /src/seetaface6_cli/build --parallel "$SEETAFACE6_BUILD_JOBS" \
    && cmake --install /src/seetaface6_cli/build \
    && mkdir -p /opt/seetaface6/lib \
    && if [ -d /src/seetaface6/build/lib ]; then cp -a /src/seetaface6/build/lib/. /opt/seetaface6/lib/; fi \
    && if [ -d /src/seetaface6/build/lib64 ]; then cp -a /src/seetaface6/build/lib64/. /opt/seetaface6/lib/; fi

FROM python:3.10-bookworm

RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libgles2-mesa \
    libegl1-mesa \
    libglib2.0-0 \
    curl \
    libzbar0 \
    libgomp1 \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
COPY vendor-wheels /tmp/vendor-wheels
RUN --mount=type=cache,target=/root/.cache/pip pip install --find-links=/tmp/vendor-wheels --timeout 300 --retries 12 -r requirements.txt
# python-pptx (extraccion de CV en PowerPoint, ADR-129) se instala en un paso
# APARTE, con --no-deps, en vez de vivir en requirements.txt. Originalmente
# esto evitaba reabrir un conflicto real entre torch y tensorflow (ver abajo
# "Silent-Face-Anti-Spoofing se movió..."); ese conflicto ya no puede
# ocurrir en este Dockerfile porque torch ya no está en requirements.txt,
# pero se deja el paso separado igual -- ya funciona, tocarlo sin necesidad
# real no vale el riesgo.
RUN --mount=type=cache,target=/root/.cache/pip pip install --no-deps "python-pptx>=1.0,<2" lxml Pillow XlsxWriter
# Silent-Face-Anti-Spoofing (PyTorch) se movió a un servicio propio,
# silentface_engine/ (Opción C, ADR-141 actualización 2026-09-03): torch
# exigía nvidia-cudnn-cu12==9.19.0.56 (major 9) y tensorflow[and-cuda]
# nvidia-cudnn-cu12==8.9.4.25 (major 8) en el MISMO proceso -- conflicto de
# major version irreconciliable, confirmado con evidencia pública
# (TensorFlow rechaza en runtime cualquier cuDNN de major distinto al que
# fue compilado). Se probó primero subir TensorFlow a 2.18 (primera línea
# con cuDNN 9.x) para alinear ambos, pero falló por un motivo más profundo:
# TF 2.18 no tiene kernels CUDA para la GPU Blackwell de este host
# (CUDA_ERROR_INVALID_PTX real, confirmado en runtime). Con torch fuera de
# este Dockerfile, el conflicto de cuDNN/NCCL desaparece de raíz -- ya no
# hace falta el paso de reinstalación forzada de nvidia-nccl-cu12 que vivía
# acá (existía solo para el choque de archivo .so entre el NCCL de torch y
# el de TensorFlow).

COPY . .
COPY --from=seetaface_builder /opt/seetaface6 /opt/seetaface6
RUN cp -a /opt/seetaface6/lib/. /usr/local/lib/ && ldconfig

# Invalida caché de capas cuando cambia el pipeline de avatar (rebuild --no-cache recomendado).
# v9: el estilizador por difusión (ADR-141) se movió a un servicio propio,
# avatar_engine/ (torch+diffusers, sin tensorflow) -- este contenedor solo
# le habla por HTTP (avatar_diffusion.py acá es un cliente, no el pipeline).
# Ver la actualización 2026-09-03 del ADR: conflicto real e irreconciliable
# de cuDNN (major 8 vs 9) entre torch==2.11.0+cu128 y
# tensorflow[and-cuda]==2.15.1 en el mismo proceso -- por eso ya no viven
# juntos.
LABEL informe.ai_engine.cartoon_pipeline="v9-diffusion-via-avatar-engine-sidecar"

# Modelo entrenado incluido en la imagen (entrenar antes del build si faltan archivos).
# Desactivar comprobación: docker build --build-arg VERIFY_GLASSES_ONNX=0 ...
ARG VERIFY_GLASSES_ONNX=1
RUN if [ "$VERIFY_GLASSES_ONNX" = "1" ]; then \
      test -f /app/models/glasses_classifier.onnx \
      && test -f /app/models/glasses_classifier_meta.json \
      || (echo "ERROR: Falta ONNX en ai_engine/models/. Ejecute: python ai_engine/scripts/train_glasses_onnx.py" >&2 && exit 1); \
    fi

ENV GLASSES_ONNX_PATH=/app/models/glasses_classifier.onnx
# Modelos InsightFace (buffalo_l, etc.); en runtime suele montarse un volumen aquí.
ENV INSIGHTFACE_ROOT=/app/.insightface
ENV SEETAFACE6_CLI_PATH=/opt/seetaface6/bin/seetaface6-face-cli
ENV SEETAFACE6_MODEL_DIR=/opt/seetaface6/models
ENV SEETAFACE6_TIMEOUT_SECONDS=20
RUN mkdir -p /app/.insightface

# Proveedor biométrico primario (deepface_silentface_adapter.py). Pesos de
# Facenet512/YuNet (DeepFace) se montan read-only en runtime -- nunca se
# descargan en el contenedor (ver docs/integration/DEEPFACE_SILENTFACE_LOCAL_DOCKER.md).
# Los pesos de detección/anti-spoofing (Silent-Face) ya no viven acá --
# silentface_engine/ tiene su propio Dockerfile con sus propios ENV/mounts.
# DEEPFACE_HOME=/app (NO /app/.deepface): deepface.commons.folder_utils
# .initialize_folder() siempre hace home + "/.deepface/weights" -- con
# DEEPFACE_HOME=/app/.deepface esa cuenta resuelve a /app/.deepface/.deepface,
# una ruta que no existe dentro del volumen read-only montado (el volumen ya
# ES ".deepface"), y el mkdir revienta con "Read-only file system" en cada
# arranque (confirmado en runtime, 2026-08-18). DEEPFACE_HOME=/app hace que la
# ruta buscada sea /app/.deepface/weights/..., que coincide con el punto de
# montaje real. docker-compose.yml ya trae este mismo valor (gana en runtime
# sobre este ENV), pero se corrige aquí también para quien use la imagen sin
# compose.
ENV DEEPFACE_HOME=/app
RUN mkdir -p /app/.deepface

# cuDNN (TensorFlow/DeepFace) hace dlopen("libnvrtc.so") -- sin sufijo de
# version -- para compilar kernels PTX en GPUs mas nuevas que los cubin
# precompilados del propio TensorFlow (confirmado en runtime con una RTX 5060
# Laptop, sm_120/Blackwell: TensorFlow 2.14.1 SI corre en GPU vía JIT de PTX,
# pero solo si esta variable esta seteada -- sin ella, cuDNN no encuentra
# libnvrtc.so aunque el archivo exista como libnvrtc.so.12 dentro del paquete
# pip nvidia-cuda-nvrtc-cu12, y el proceso termina en SIGABRT/SIGSEGV al
# primer forward de un modelo real). Sin esto, ai_engine sigue funcionando
# pero corriendo TODO en CPU silenciosamente.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.10/site-packages/nvidia/cuda_cupti/lib:/usr/local/lib/python3.10/site-packages/nvidia/nvjitlink/lib:/usr/local/lib/python3.10/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.10/site-packages/nvidia/cusolver/lib:/usr/local/lib/python3.10/site-packages/nvidia/cuda_nvrtc/lib:/usr/local/lib/python3.10/site-packages/nvidia/curand/lib:/usr/local/lib/python3.10/site-packages/nvidia/nccl/lib:/usr/local/lib/python3.10/site-packages/nvidia/cusparse/lib:/usr/local/lib/python3.10/site-packages/nvidia/nvtx/lib:/usr/local/lib/python3.10/site-packages/nvidia/cuda_nvcc/lib:/usr/local/lib/python3.10/site-packages/nvidia/cufft/lib:/usr/local/lib/python3.10/site-packages/nvidia/cublas/lib

EXPOSE 5000

# Normalizar CRLF→LF por si el repo en Windows copió el .sh con finales Windows
# (sin esto el shebang falla y el contenedor reinicia en bucle).
RUN sed -i 's/\r$//' /app/docker_entrypoint.sh 2>/dev/null || true \
    && chmod +x /app/docker_entrypoint.sh

# Descarga modelos si faltan, luego Flask (inline evita depender solo del shebang).
CMD ["/bin/sh", "-c", "python -u /app/mediapipe_models_fetch.py && exec python -u /app/eye_analyzer.py"]
