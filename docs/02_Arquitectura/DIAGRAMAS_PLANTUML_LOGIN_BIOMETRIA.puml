' =============================================================================
' LOGIN y VALIDACION BIOMETRICA — PlantUML (rectangle + flechas)
' Mismo formato que DIAGRAMAS_PLANTUML_FORMULA_Y_BACKEND.puml
' Copiar UN bloque @startuml...@enduml por vez si el render falla
' Evitar llaves en textos de rectangulos
' =============================================================================


' #############################################################################
' B01 — Vista global: cliente, borde HTTP, backend, BD, motor IA
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B01 - Vista global login y biometria

rectangle "Navegador\nSPA AuthGateway" as CL
rectangle "nginx frontend\nproxy /api a backend" as NG
rectangle "backend C++\npuerto 8081" as BE
rectangle "sensors_db\nPostgreSQL usuarios\nplantillas faciales" as DB
rectangle "ai_engine\nPython :5000\nojos / embedding / ONNX" as AI

CL --> NG : HTTPS /api/auth/*
NG --> BE
BE --> DB : consultas auth
BE --> AI : HTTP si AI_ENGINE_URL\nanalyze_eyes, face_embedding

@enduml


' #############################################################################
' B02 — Login con contraseña (POST /api/auth/login/password)
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B02 - Login con contrasena

rectangle "Cliente\nPOST JSON\ncompany, username, password" as C
rectangle "backend\nvalidar cuerpo JSON" as V
rectangle "Modo Postgres\nloginPasswordPg\nhash password" as PG
rectangle "Modo archivo\nloadAuthUsers\ncomparar hash" as FS
rectangle "Usuario valido" as OK
rectangle "Respuesta 401\nerror credenciales" as KO
rectangle "issueAuthSession\ntoken sesion" as SE
rectangle "JSON 200\nstatus authenticated\nuser + token" as OUT

C --> V
V --> KO : payload invalido
V --> PG : AuthStorage Postgres
V --> FS : AuthStorage archivo
PG --> KO : fallo DB
PG --> OK
FS --> KO : no match
FS --> OK
OK --> SE
SE --> OUT

@enduml


' #############################################################################
' B03 — Login facial: visión general (POST /api/auth/login/face)
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B03 - Login facial vision general

rectangle "Cliente\nPOST company\nidentity_login\nface_template O face_image_base64" as C
rectangle "backend\nvalidar JSON y campos" as V
rectangle "Resolver usuario\npor username DNI o RUC\nen la empresa" as U
rectangle "Construir probe facial\nembedding o legacy CV" as P
rectangle "Comparar con plantilla\nregistrada umbral coseno" as M
rectangle "issueAuthSession" as S
rectangle "200 authenticated\nmethod face\nscore provider" as OK
rectangle "401 error\ndiagnostico en JSON" as ER

C --> V
V --> ER : falta empresa o identidad o dato facial
V --> U
U --> ER : sin usuario o ambiguo o sin biometria
U --> P
P --> ER : probe invalido
P --> M
M --> ER : score bajo umbral
M --> S
S --> OK

@enduml


' #############################################################################
' B04 — Verificación de calidad de frame (POST /api/auth/biometric/verify-frame)
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B04 - Verificar calidad de rostro antes de login

rectangle "Cliente\nPOST face_image_base64" as C
rectangle "backend\nrunBiometricVerifyForImageBase64" as R
rectangle "OpenCV / reglas\niluminacion nitidez pose" as CV
rectangle "ai_engine\nopcional\nsi URL configurada" as AI
rectangle "JSON ok, issues[]\nquality_score provider" as OUT

C --> R
R --> CV
R --> AI : enriquecimiento
CV --> OUT
AI --> OUT

@enduml


' #############################################################################
' B05 — Procesamiento de frame en vivo (POST /api/process_frame)
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B05 - Process frame captura ovalo / guia usuario

rectangle "Cliente\ncuerpo binario imagen JPEG" as C
rectangle "backend\ndecodificar Mat\nre-encode base64" as D
rectangle "runBiometricVerifyForImageBase64" as E
rectangle "Fusion eval\nCV + respuesta IA\nojos boca gafas frontal" as F
rectangle "Estado global captura\ndetected eyesOpen\novalo elipse si hay" as ST
rectangle "JSON estado\npara UI ovalo" as OUT

C --> D
D --> E
E --> F
F --> ST
ST --> OUT

@enduml


' #############################################################################
' B06 — Estado del subsistema biométrico (GET /api/auth/biometric/status)
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B06 - Estado biometria solo admin

rectangle "Cliente admin\nGET con sesion" as C
rectangle "backend\nresolveAuthSession\nrol admin" as A
rectangle "403\nsin permiso" as F
rectangle "JSON provider\ndermalog_required\ndnn runtime status" as OK

C --> A
A --> F : no admin
A --> OK

@enduml


' #############################################################################
' B07 — Registro de usuario (POST /api/auth/register) vinculo biometria
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B07 - Registro con opcion plantilla facial

rectangle "Cliente\nPOST register\ndatos usuario\nface opcional" as C
rectangle "backend\nvalidaciones\nQC rostro si hay imagen" as V
rectangle "Persistir\nPostgres o archivo\nembedding ONNX si aplica" as P
rectangle "issueAuthSession\nusuario creado" as S
rectangle "200 user token" as OK
rectangle "400 error" as ER

C --> V
V --> ER
V --> P
P --> ER
P --> S
S --> OK

@enduml


' #############################################################################
' B08 — Auditoría de intentos (auth_audit_logs)
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B08 - Auditoria login password y face

rectangle "Evento login_password\no login_face" as E
rectangle "appendAuthAuditLog\nPostgres o archivo" as L
rectangle "Consulta admin\nGET /api/auth/audit" as Q
rectangle "sensors_db o logs\nhistorial intentos" as DB

E --> L
L --> DB
Q --> DB

@enduml


' #############################################################################
' B09 — Secuencia típica: primero guía facial, luego login face (resumen)
' #############################################################################
@startuml
skinparam rectangle {
  roundCorner 12
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam arrowColor #1E293B

title B09 - Secuencia recomendada en UI

rectangle "1 Usuario elige empresa" as S1
rectangle "2 Opcional verify-frame\ncomprobar calidad" as S2
rectangle "3 Opcional process_frame\nhasta ovalo verde" as S3
rectangle "4 POST login/face\ncon plantilla o imagen" as S4
rectangle "5 Sesion con token" as S5

S1 --> S2
S2 --> S3
S3 --> S4
S4 --> S5

@enduml
