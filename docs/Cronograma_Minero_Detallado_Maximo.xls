.gantt-fill { background-color: #f7a827; color: #f7a827; box-shadow: inset 0 0 0 1px #d68706; } /* Naranja estilo premium */
.week-col { text-align: center; width: 35px; font-size: 9pt; background-color:#365f91; color:white; border-left: 1px dotted #ffffff; }
.res-col { text-align: center; color: #0b2f5c; font-weight: bold; font-size: 10pt; }
</style>
